#!/bin/bash
# postinst script for mongoman deb package

set -e

case "$1" in
    configure)
        # Reload systemd daemon
        systemctl daemon-reload > /dev/null 2>&1 || true

        # Enable and start the service
        systemctl enable mongoman > /dev/null 2>&1 || true
        systemctl start mongoman > /dev/null 2>&1 || true
        ;;
esac

exit 0