#!/bin/bash
# prerm script for mongoman deb package

set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Stop and disable the service
        systemctl stop mongoman > /dev/null 2>&1 || true
        systemctl disable mongoman > /dev/null 2>&1 || true
        systemctl daemon-reload > /dev/null 2>&1 || true
        ;;
esac

exit 0